# MariaDB / MySQL connection string
DATABASE_URL="mysql://user:password@localhost:3306/techtune_healer"

# Required - at least 16 chars. Server refuses to start without it.
JWT_SECRET=change-me-to-a-long-random-string

# Optional
PORT=4000
NODE_ENV=development

# Comma-separated origin allowlists (omit for open CORS - bearer-token auth)
# CORS_ORIGINS=https://app.techtunehealer.com
# SOCKET_ORIGINS=https://app.techtunehealer.com
