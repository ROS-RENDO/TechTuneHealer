{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "App.tsx",
    "app/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "backend",
    ".expo",
    ".scannerwork"
  ]
}
